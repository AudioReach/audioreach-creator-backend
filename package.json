{
  "name": "audioreach-creator-api",
  "version": "1.0.0",
  "description": "Audio Reach Creator API is an open source and cross platform backend framework for updating Audio Reach database files.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/infrastructure/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @arc/core run build",
    "build:fs": "pnpm --filter @arc/fs run build",
    "build:persistence": "pnpm --filter @arc/persistence run build",
    "build:api": "pnpm --filter @arc/api run build",
    "start": "pnpm --filter @arc/api run start",
    "start:dev": "pnpm --filter @arc/api run start:dev",
    "start:debug": "pnpm --filter @arc/api run start:debug",
    "start:prod": "pnpm --filter @arc/api run start:prod",
    "generate:swagger": "pnpm --filter @arc/api run generate:swagger",
    "coverage:workspace": "pnpm run coverage:collect && pnpm run coverage:merge-files && pnpm run coverage:generate-reports && pnpm run coverage:cleanup",
    "coverage:collect": "shx mkdir -p temp-coverage && shx cp packages/api/coverage/coverage-final.json temp-coverage/api.json && shx cp packages/core/coverage/coverage-final.json temp-coverage/core.json && shx cp packages/infrastructure/persistence/coverage/coverage-final.json temp-coverage/persistence.json",
    "coverage:merge-files": "shx mkdir -p coverage/merged && nyc merge temp-coverage coverage/merged/coverage-final.json",
    "coverage:generate-reports": "nyc report --reporter=html --reporter=json --temp-dir=coverage/merged --report-dir=coverage/merged",
    "coverage:cleanup": "shx rm -rf temp-coverage",
    "coverage:clean": "shx rm -rf coverage && turbo run coverage:clean",
    "clean": "pnpm -r run clean",
    "format": "pnpm -r run format",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migration:run:tmp": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:run",
    "migration:gen": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:generate",
    "migration:revert": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:revert",
    "migration:show": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:show",
    "migration:gen:logging": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/logging-data-source-cli.js migration:generate",
    "migration:revert:logging": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/logging-data-source-cli.js migration:revert",
    "migration:show:logging": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/logging-data-source-cli.js migration:show",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "coverage": "turbo run coverage:workspace",
    "setup-ai-links": "node scripts/setup-ai-links.js"
  },
  "keywords": [
    "audioreach",
    "audioreach-api",
    "acdb",
    "workspace",
    "arc"
  ],
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/eslint-plugin-security": "^3",
    "@types/node": "^22.10.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-unicorn": "^60.0.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.5.6",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "license": "BSD-3-Clause"
}
