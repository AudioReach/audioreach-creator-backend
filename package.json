{
  "name": "audioreach-creator-api",
  "version": "1.0.0",
  "description": "Audio Reach Creator API is an open source and cross platform backend framework for updating Audio Reach database files.",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/infrastructure/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --topological --all run build",
    "build:core": "yarn workspace @arc/core build",
    "build:fs": "yarn workspace @arc/fs build",
    "build:persistence": "yarn workspace @arc/persistence build",
    "build:api": "yarn workspace @arc/api build",
    "start": "yarn workspace @arc/api start",
    "start:dev": "yarn workspace @arc/api start:dev",
    "start:debug": "yarn workspace @arc/api start:debug",
    "start:prod": "yarn workspace @arc/api start:prod",
    "generate:swagger": "yarn workspace @arc/api generate:swagger",
    "coverage:workspace": "yarn run coverage:collect && yarn run coverage:merge-files && yarn run coverage:generate-reports && yarn run coverage:cleanup",
    "coverage:collect": "shx mkdir -p temp-coverage && shx cp packages/api/coverage/coverage-final.json temp-coverage/api.json && shx cp packages/core/coverage/coverage-final.json temp-coverage/core.json",
    "coverage:merge-files": "shx mkdir -p coverage/merged && nyc merge temp-coverage coverage/merged/coverage-final.json",
    "coverage:generate-reports": "nyc report --reporter=html --reporter=json --temp-dir=coverage/merged --report-dir=coverage/merged",
    "coverage:cleanup": "shx rm -rf temp-coverage",
    "coverage:clean": "shx rm -rf coverage && turbo run coverage:clean",
    "clean": "yarn workspaces foreach --all run clean",
    "format": "yarn workspaces foreach --all run format",
    "format:check": "prettier --check \"**/*.{js,ts,json}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migration:run:tmp": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:run",
    "migration:gen": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:generate",
    "migration:revert": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:revert",
    "migration:show": "typeorm -d ./packages/api/dist/infrastructure-wrapper/database/data-source-cli.js migration:show"
  },
  "keywords": [
    "audioreach",
    "audioreach-api",
    "acdb",
    "workspace",
    "arc"
  ],
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/eslint-plugin-security": "^3",
    "@types/node": "^22.10.2",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-unicorn": "^60.0.0",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.5.6",
    "typeorm": "^0.3.28",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.5.3",
  "license": "BSD-3-Clause"
}
