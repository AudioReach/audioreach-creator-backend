{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "package.json"],
      "cache": true
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", "*.tsbuildinfo"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "jest.config.mjs",
        "package.json"
      ],
      "cache": true
    },
    "test:unit": {
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.ts",
        "tests/unit/**/*.ts",
        "jest.config.mjs",
        "package.json"
      ],
      "cache": true
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.ts",
        "tests/integration/**/*.ts",
        "jest.config.mjs",
        "package.json"
      ],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.ts",
        "tests/e2e/**/*.ts",
        "jest.config.mjs",
        "package.json"
      ],
      "cache": true
    },
    "coverage:api": {
      "dependsOn": ["@arc/api#build"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "../core/src/**/*.ts",
        "jest.config.mjs",
        "package.json"
      ],
      "cache": true
    },
    "coverage:core": {
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "jest.config.mjs",
        "package.json"
      ],
      "cache": true
    },
    "coverage:persistence": {
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "jest.config.mjs",
        "package.json"
      ],
      "cache": true
    },
    "//#coverage:workspace": {
      "dependsOn": [
        "@arc/api#coverage:api",
        "@arc/core#coverage:core",
        "@arc/persistence#coverage:persistence"
      ],
      "outputs": ["coverage/**", "temp-coverage/**", "test-results/**"],
      "inputs": [
        "package.json",
        "pnpm-lock.yaml",
        "scripts/merge-junit-reports.mjs",
        "packages/api/coverage/coverage-final.json",
        "packages/core/coverage/coverage-final.json",
        "packages/infrastructure/persistence/coverage/coverage-final.json",
        "packages/api/src/**/*.ts",
        "packages/core/src/**/*.ts",
        "packages/infrastructure/persistence/src/**/*.ts"
      ],
      "cache": true
    },
    "coverage:clean": {
      "cache": false
    }
  }
}
