{
  "compilerOptions": {
    "noEmit": true,
    "types": ["jest", "node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "sourceMap": true,
    "inlineSourceMap": false
  },
  "include": ["**/*.spec.ts", "tests/**/*", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
