{
  "name": "@arc/core",
  "version": "1.0.0",
  "private": true,
  "description": "Core domain entities and business logic for ARC API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "shx rm -rf dist *.tsbuildinfo",
    "test:core": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test:unit:core": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --passWithNoTests",
    "test:integration:core": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --passWithNoTests",
    "coverage:core": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --passWithNoTests",
    "coverage:clean": "shx rm -rf coverage",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "arc-api-core",
    "audioreach-api-core"
  ],
  "peerDependencies": {
    "typeorm": "^0.3.0"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "jest": "^30.1.3",
    "jest-junit": "^16.0.0",
    "jest-ts-webcompat-resolver": "^1.0.1",
    "prettier": "^3.6.2",
    "shx": "^0.3.4",
    "ts-jest": "^29.4.0",
    "typeorm": "^0.3.0",
    "typescript": "^5.8.3"
  },
  "license": "BSD-3-Clause-Clear"
}
