{
  "name": "@arc/core",
  "version": "1.0.0",
  "private": true,
  "description": "Core domain entities and business logic for ARC API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist *.tsbuildinfo",
    "test:core": "jest --passWithNoTests",
    "test:unit:core": "jest --selectProjects unit --passWithNoTests",
    "test:integration:core": "jest --selectProjects integration --passWithNoTests",
    "coverage:core": "jest --coverage --passWithNoTests",
    "coverage:clean": "shx rm -rf coverage",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "arc-api-core",
    "audioreach-api-core"
  ],
  "peerDependencies": {
    "typeorm": "^0.3.0"
  },
  "dependencies": {
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "jest": "^30.1.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.0",
    "typeorm": "^0.3.0",
    "typescript": "^5.8.3"
  },
  "license": "BSD-3-Clause-Clear"
}
