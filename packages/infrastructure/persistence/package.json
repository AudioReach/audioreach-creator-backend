{
  "name": "@arc/persistence",
  "version": "1.0.0",
  "private": true,
  "description": "Persistence layer implementation for ARC API using TypeORM and SQLite",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "shx rm -rf dist *.tsbuildinfo",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "arc-api-persistence",
    "audioreach-api-persistence"
  ],
  "peerDependencies": {
    "@arc/core": "workspace:*",
    "typeorm": "^0.3.28"
  },
  "dependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@arc/core": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-resolve": "^29.7.0",
    "jest-ts-webcompat-resolver": "^1.0.1",
    "prettier": "^3.6.2",
    "shx": "^0.3.4",
    "ts-jest": "^29.4.6",
    "typeorm": "^0.3.28",
    "typescript": "^5.8.3"
  },
  "license": "BSD-3-Clause"
}
